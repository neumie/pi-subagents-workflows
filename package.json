{
  "name": "pi-subagents-workflows",
  "version": "0.1.1",
  "description": "Strict JSON workflow orchestration for pi-subagents and the Pi coding agent",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-subagents",
    "workflows",
    "ai",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neumie/pi-subagents-workflows.git"
  },
  "homepage": "https://github.com/neumie/pi-subagents-workflows",
  "bugs": {
    "url": "https://github.com/neumie/pi-subagents-workflows/issues"
  },
  "files": [
    "src",
    "README.md",
    "PLAN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ir": "./src/ir/index.ts",
    "./engine": "./src/engine/index.ts"
  },
  "scripts": {
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:provider-artifact": "node --test test/provider-artifact.test.mjs",
    "test:provider-extension-e2e": "node --test test/provider-extension-e2e.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run typecheck",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "dependencies": {
    "jiti": "2.7.0",
    "pi-subagents": ">=0.36.0 <0.39.0",
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.81.0 <0.84.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
